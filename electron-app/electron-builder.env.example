# Code Signing Environment Variables
# Copy this file to electron-builder.env and fill in your values
# DO NOT commit electron-builder.env to git!

# Windows Code Signing
# Option 1: PFX file (traditional)
CSC_LINK=path/to/your/certificate.pfx
CSC_KEY_PASSWORD=your_certificate_password

# Option 2: Windows Certificate Store (if installed in Windows)
# CSC_NAME=Your Certificate Subject Name

# Optional: Timestamp server (recommended)
# This ensures the signature remains valid after certificate expires
SIGNTOOL_TIMESTAMP_URL=http://timestamp.sectigo.com
