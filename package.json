{
  "name": "ephemeral-chat",
  "version": "1.0.0",
  "description": "Private, temporary chat rooms with real-time messaging",
  "main": "server/index.js",
  "engines": {
    "node": ">=16.0.0",
    "npm": ">=8.0.0"
  },
  "scripts": {
    "dev": "concurrently \"npm run server\" \"npm run client\"",
    "server": "node server/index.js",
    "simple": "node server/simple-server.js",
    "client": "cd client && npm run dev",
    "build": "cd client && npm install && npm run build",
    "start": "node server/index.js",
    "test": "node --test client/test/privacy-pass-roundtrip.test.js",
    "test:privacy-pass": "node --test client/test/privacy-pass-roundtrip.test.js"
  },
  "keywords": [
    "chat",
    "websocket",
    "Private",
    "ephemeral",
    "real-time"
  ],
  "author": "Caleb Kyere-Boateng",
  "license": "Apache-2.0",
  "dependencies": {
    "@cap.js/server": "^4.0.5",
    "@ffmpeg-installer/ffmpeg": "^1.1.0",
    "@ffprobe-installer/ffprobe": "^2.1.2",
    "@noble/curves": "^1.8.1",
    "agora-token": "^2.0.5",
    "bcryptjs": "^2.4.3",
    "cbor": "^10.0.12",
    "cors": "^2.8.5",
    "dotenv": "^16.6.1",
    "express": "^4.21.2",
    "express-rate-limit": "^8.2.1",
    "fluent-ffmpeg": "^2.1.3",
    "helmet": "^8.1.0",
    "hpke": "^1.0.4",
    "http-proxy-middleware": "^3.0.5",
    "jsonwebtoken": "^9.0.3",
    "lamejs": "^1.2.1",
    "mlkem": "^2.5.0",
    "redis": "^4.6.8",
    "sanitize-html": "^2.17.0",
    "socket.io": "^4.7.2",
    "uuid": "^13.0.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.7.0",
    "autoprefixer": "^10.4.23",
    "concurrently": "^8.2.0",
    "esbuild": "^0.27.2",
    "nodemon": "^3.0.1",
    "postcss": "^8.5.6",
    "tailwindcss": "^4.1.18"
  }
}
