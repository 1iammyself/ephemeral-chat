+      const isHttps = gatewayUrl.protocol === 'https:';
+      const transport = isHttps ? https : http;
+
+      const options = {
+        hostname: gatewayUrl.hostname,
+        port: gatewayUrl.port || (isHttps ? 443 : 80),
+        path: gatewayUrl.pathname,
+        method: 'POST',
+        headers: {
+          ...forwardHeaders,
+          'content-length': body.length,
+        },
